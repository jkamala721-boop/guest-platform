# Copy to .env for local use, then replace every placeholder with values from
# the Supabase dashboard's Connect panel. Do not commit the resulting .env file.
# Use the Session pooler connection string when the application runs on an
# IPv4-only network (including many hosted environments).
SUPABASE_DB_JDBC_URL=jdbc:postgresql://aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<database-password>

# Keep the application pool small on Supabase's shared pooler.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=10000

# Payment adapters default to safe mock mode. For Stripe Checkout sandbox use
# STRIPE_PAYMENT_MODE=live with test-mode credentials only in an ignored local
# .env or deployment-secret store.
MPESA_PAYMENT_MODE=mock
MPESA_WEBHOOK_SECRET=<mpesa-webhook-secret>
STRIPE_PAYMENT_MODE=mock
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
HOSTVERO_PUBLIC_BASE_URL=http://localhost:8080

# Phase 6 notifications are mock-only until a delivery provider is approved.
NOTIFICATION_MODE=mock
NOTIFICATION_SCHEDULER_FIXED_DELAY_MS=60000
PAYMENT_REMINDER_HOURS_BEFORE_CHECKIN=12
