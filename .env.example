# Copy to .env for local use, then replace every placeholder with values from
# the Supabase dashboard's Connect panel. Do not commit the resulting .env file.
# Use the Session pooler connection string when the application runs on an
# IPv4-only network (including many hosted environments).
SUPABASE_DB_JDBC_URL=jdbc:postgresql://aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<database-password>

# Keep the application pool small on Supabase's shared pooler.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=10000

# Payment adapters default to safe mock mode. For Stripe Checkout sandbox use
# STRIPE_PAYMENT_MODE=live with test-mode credentials only in an ignored local
# .env or deployment-secret store.
MPESA_PAYMENT_MODE=mock
MPESA_WEBHOOK_SECRET=<mpesa-webhook-secret>
STRIPE_PAYMENT_MODE=mock
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
# Paystack handles Kenya M-Pesa and card checkout server-side. Its public key is
# reserved for future client integrations and is not exposed by this application.
PAYSTACK_PAYMENT_MODE=mock
PAYSTACK_SECRET_KEY=<paystack-secret-key>
PAYSTACK_PUBLIC_KEY=<paystack-public-key>
HOSTVERO_PAYOUT_FINGERPRINT_SECRET=<dedicated-payout-fingerprint-secret>
HOSTVERO_GUEST_IDENTITY_FINGERPRINT_SECRET=<dedicated-guest-identity-fingerprint-secret>
HOSTVERO_PROPERTY_ACCESS_ENCRYPTION_KEY=<base64-32-byte-aes-key>
# The M-Pesa payout worker is independent from guest-payment webhooks. Keep it
# enabled only after the Paystack Transfer API is enabled for the platform account.
HOST_PAYOUT_SCHEDULER_ENABLED=true
HOST_PAYOUT_SCHEDULER_FIXED_DELAY_MS=300000
HOST_PAYOUT_SCHEDULER_BATCH_SIZE=20
HOST_PAYOUT_SETTLEMENT_HOLD_MINUTES=1440
HOST_PAYOUT_MAXIMUM_ATTEMPTS=3
# Host payout destinations are configured by each authenticated host in Settings.
# Hosts never provide Paystack credentials. In live mode, use bank codes returned
# by Paystack's List Banks API for the platform's Kenya-enabled account.
# Kenyan individual M-Pesa destinations are Paystack transfer recipients. Hostvero
# stores only a keyed fingerprint and masked final four digits, never the raw number.
# Local development may use localhost. Render production must use the final HTTPS origin.
HOSTVERO_PUBLIC_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=
# Host sessions use an HttpOnly cookie. Production fixes the lifetime at 30 days
# and enables Secure cookies through the prod profile; no browser token is stored.
AUTH_SESSION_TTL_HOURS=720

# Separate management-domain authentication. Bootstrap values are used only when
# no admin exists; remove all three bootstrap variables from Render after creation.
HOSTVERO_ADMIN_PUBLIC_BASE_URL=https://admin.hostvero.net
HOSTVERO_ADMIN_SESSION_DURATION_HOURS=12
HOSTVERO_ADMIN_BOOTSTRAP_EMAIL=
HOSTVERO_ADMIN_BOOTSTRAP_PASSWORD=
HOSTVERO_ADMIN_BOOTSTRAP_NAME=
HOSTVERO_HOST_IDENTITY_FINGERPRINT_SECRET=
ADMIN_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# NOTIFICATION_MODE remains a legacy compatibility setting. Scheduled notifications
# use NOTIFICATION_DEFAULT_CHANNEL explicitly; keep WhatsApp disabled until Meta is ready.
NOTIFICATION_MODE=mock
NOTIFICATION_DEFAULT_CHANNEL=EMAIL
RESEND_ENABLED=true
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_HOST_NOTIFICATION_TEMPLATE_ID=d23c7838-b503-4792-b7f9-60e54969828c
RESEND_HOST_NOTIFICATION_TEMPLATE_ALIAS=hostvero-host-notification
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=<meta-whatsapp-access-token>
WHATSAPP_PHONE_NUMBER_ID=<meta-whatsapp-phone-number-id>
# Set this to a currently supported Graph API version from the Meta app dashboard, for example vXX.X.
WHATSAPP_API_VERSION=<meta-graph-api-version>
WHATSAPP_MANUAL_TEMPLATE_NAME=<approved-manual-template-name>
WHATSAPP_GUEST_LINK_TEMPLATE_NAME=<approved-guest-link-template-name>
WHATSAPP_SCHEDULED_TEMPLATE_NAME=<approved-scheduled-template-name>
WHATSAPP_LANGUAGE_CODE=en
NOTIFICATION_SCHEDULER_FIXED_DELAY_MS=60000
PAYMENT_REMINDER_HOURS_BEFORE_CHECKIN=12
GUEST_EMAIL_VERIFICATION_TTL_SECONDS=600
GUEST_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
GUEST_EMAIL_VERIFICATION_MAXIMUM_ATTEMPTS=5
RETURNING_GUEST_VERIFICATION_TTL_SECONDS=600
RETURNING_GUEST_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
RETURNING_GUEST_VERIFICATION_MAXIMUM_ATTEMPTS=5
